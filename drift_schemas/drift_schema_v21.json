  "fixed_sql": [
    {
      "name": "servers",
      "sql": [
        {
          "dialect": "sqlite",
          "sql": "CREATE TABLE IF NOT EXISTS \"servers\" (\"id\" TEXT NOT NULL, \"url\" TEXT NOT NULL, \"name\" TEXT NOT NULL, \"trust_self_signed_certs\" INTEGER NOT NULL DEFAULT 0 CHECK (\"trust_self_signed_certs\" IN (0, 1)), \"use_header_auth\" INTEGER NOT NULL DEFAULT 0 CHECK (\"use_header_auth\" IN (0, 1)), \"created_at\" INTEGER NOT NULL DEFAULT (CAST(strftime('%s', CURRENT_TIMESTAMP) AS INTEGER)), PRIMARY KEY (\"id\"));"
        }
      ]
    },
    {
      "name": "accounts",
      "sql": [
        {
          "dialect": "sqlite",
          "sql": "CREATE TABLE IF NOT EXISTS \"accounts\" (\"id\" TEXT NOT NULL, \"server_id\" TEXT NOT NULL REFERENCES servers (id), \"user_id\" TEXT NOT NULL, \"email\" TEXT NOT NULL, \"fingerprint\" TEXT NULL, \"public_key\" TEXT NULL, \"wrapping_public_key\" TEXT NULL, \"encrypted_private_key\" TEXT NULL, \"pin_encrypted_private_key\" TEXT NULL, \"biometric_pin\" TEXT NULL, \"quota\" INTEGER NULL, \"role\" TEXT NULL, \"is_active\" INTEGER NOT NULL DEFAULT 0 CHECK (\"is_active\" IN (0, 1)), \"created_at\" INTEGER NOT NULL DEFAULT (CAST(strftime('%s', CURRENT_TIMESTAMP) AS INTEGER)), \"last_used_at\" INTEGER NULL, \"cache_limit_bytes\" INTEGER NULL, \"header_jwt\" TEXT NULL, \"header_refresh_token\" TEXT NULL, PRIMARY KEY (\"id\"));"
        }
      ]
    },
    {
      "name": "cached_files",
      "sql": [
        {
          "dialect": "sqlite",
          "sql": "CREATE TABLE IF NOT EXISTS \"cached_files\" (\"account_id\" TEXT NOT NULL REFERENCES accounts (id), \"id\" TEXT NOT NULL, \"dir_id\" TEXT NULL, \"encrypted_name\" TEXT NOT NULL, \"decrypted_name\" TEXT NULL, \"encrypted_key\" TEXT NULL, \"encrypted_thumbnail\" TEXT NULL, \"mime\" TEXT NOT NULL, \"size\" INTEGER NULL, \"chunks\" INTEGER NULL, \"chunks_stored\" INTEGER NULL, \"cipher\" TEXT NOT NULL DEFAULT 'aegis128l', \"file_modified_at\" INTEGER NULL, \"created_at\" INTEGER NULL, \"finished_upload_at\" INTEGER NULL, \"cache_policy\" TEXT NOT NULL DEFAULT 'auto', \"synced_at\" INTEGER NULL, PRIMARY KEY (\"account_id\", \"id\"));"
        }
      ]
    },
    {
      "name": "offline_files",
      "sql": [
        {
          "dialect": "sqlite",
          "sql": "CREATE TABLE IF NOT EXISTS \"offline_files\" (\"account_id\" TEXT NOT NULL, \"file_id\" TEXT NOT NULL, \"local_path\" TEXT NOT NULL, \"size_on_disk\" INTEGER NOT NULL DEFAULT 0, \"pinned\" INTEGER NOT NULL DEFAULT 0 CHECK (\"pinned\" IN (0, 1)), \"downloaded_at\" INTEGER NOT NULL DEFAULT (CAST(strftime('%s', CURRENT_TIMESTAMP) AS INTEGER)), \"last_accessed_at\" INTEGER NOT NULL DEFAULT (CAST(strftime('%s', CURRENT_TIMESTAMP) AS INTEGER)), PRIMARY KEY (\"account_id\", \"file_id\"));"
        }
      ]
    },
    {
      "name": "pending_uploads",
      "sql": [
        {
          "dialect": "sqlite",
          "sql": "CREATE TABLE IF NOT EXISTS \"pending_uploads\" (\"id\" INTEGER NOT NULL PRIMARY KEY AUTOINCREMENT, \"account_id\" TEXT NOT NULL, \"local_path\" TEXT NOT NULL, \"target_dir_id\" TEXT NULL, \"status\" TEXT NOT NULL DEFAULT 'pending', \"retry_count\" INTEGER NOT NULL DEFAULT 0, \"next_retry_at\" INTEGER NULL, \"created_at\" INTEGER NOT NULL DEFAULT (CAST(strftime('%s', CURRENT_TIMESTAMP) AS INTEGER)));"
        }
      ]
    },
    {
      "name": "pending_downloads",
      "sql": [
        {
          "dialect": "sqlite",
          "sql": "CREATE TABLE IF NOT EXISTS \"pending_downloads\" (\"id\" INTEGER NOT NULL PRIMARY KEY AUTOINCREMENT, \"account_id\" TEXT NOT NULL, \"file_id\" TEXT NOT NULL, \"chunk_count\" INTEGER NOT NULL, \"output_dir\" TEXT NOT NULL, \"output_path\" TEXT NULL, \"created_at\" INTEGER NOT NULL DEFAULT (CAST(strftime('%s', CURRENT_TIMESTAMP) AS INTEGER)), UNIQUE (\"account_id\", \"file_id\"));"
        }
      ]
    },
    {
      "name": "mcp_settings",
      "sql": [
        {
          "dialect": "sqlite",
          "sql": "CREATE TABLE IF NOT EXISTS \"mcp_settings\" (\"account_id\" TEXT NOT NULL, \"enabled\" INTEGER NOT NULL DEFAULT 0 CHECK (\"enabled\" IN (0, 1)), \"port\" INTEGER NOT NULL DEFAULT 19548, \"bearer_token\" TEXT NOT NULL DEFAULT '', \"created_at\" INTEGER NOT NULL DEFAULT (CAST(strftime('%s', CURRENT_TIMESTAMP) AS INTEGER)), \"allow_read_only_while_locked\" INTEGER NOT NULL DEFAULT 0 CHECK (\"allow_read_only_while_locked\" IN (0, 1)), \"rate_limit_rps\" INTEGER NOT NULL DEFAULT 5, \"rate_limit_burst\" INTEGER NOT NULL DEFAULT 20, \"audit_retention_days\" INTEGER NOT NULL DEFAULT 30, \"last_audit_cleanup_at\" INTEGER NULL, PRIMARY KEY (\"account_id\"));"
        }
      ]
    },
    {
      "name": "mcp_audit_log",
      "sql": [
        {
          "dialect": "sqlite",
          "sql": "CREATE TABLE IF NOT EXISTS \"mcp_audit_log\" (\"id\" INTEGER NOT NULL PRIMARY KEY AUTOINCREMENT, \"timestamp\" INTEGER NOT NULL, \"session_id\" TEXT NOT NULL, \"account_id\" TEXT NULL, \"tool_name\" TEXT NOT NULL, \"params_hash\" TEXT NOT NULL, \"result_status\" TEXT NOT NULL, \"error_message\" TEXT NULL, \"duration_ms\" INTEGER NOT NULL);"
        }
      ]
    },
