# Miscellaneous
*.class
*.log
*.pyc
*.swp
.DS_Store
.atom/
.build/
.buildlog/
.history
.svn/
.swiftpm/
migrate_working_dir/

# IntelliJ related
*.iml
*.ipr
*.iws
.idea/

# The .vscode folder contains launch configuration and tasks you configure in
# VS Code which you may wish to be included in version control, so this line
# is commented out by default.
#.vscode/

# Flutter/Dart/Pub related
**/doc/api/
**/ios/Flutter/.last_build_id
.dart_tool/
.flutter-plugins-dependencies
.pub-cache/
.pub/
/build/
/coverage/

# Symbolication related
app.*.symbols

# Obfuscation related
app.*.map.json

# Android Studio will place build artifacts here
/android/app/debug
/android/app/profile
/android/app/release

# Flutter plugins cache
.flutter-plugins

# Signing. Everything here is unrecoverable once it reaches a public remote,
# so the patterns are deliberately broader than the files we actually use.
android/key.properties
android/app/upload.jks
*.jks
*.keystore
*.p12
*.pfx
*.mobileprovision
*.provisionprofile
*.cer
*.certSigningRequest
AuthKey_*.p8

# Local environment overrides — never committed, values differ per machine.
.env
.env.*
!.env.example

# release-check artifact staging (per-job downloads consumed by dashboard.py)
artifacts/

# Fastlane
fastlane/report.xml
fastlane/Preview.html
fastlane/screenshots
fastlane/test_output

# Release check tool scratch dir (generated at runtime)
.release-check/

# Compat gate Python venv (scripts/compat/bootstrap.sh bootstraps this)
scripts/compat/.venv/
__pycache__/

# Release-check bootstrap: Playwright npm tree + chromium download.
# package.json + register-user.cjs ARE committed; the install artefacts
# below are regenerated by scripts/release-check/bootstrap.sh on first run.
scripts/release-check/bootstrap/node_modules/
scripts/release-check/bootstrap/.ready
scripts/release-check/bootstrap/package-lock.json

# Patrol generated test bundles (regenerated per-run by patrol_cli)
# Both bundles carry a "DO NOT COMMIT" banner and embed absolute local paths,
# so they must never be tracked.
patrol_test/test_bundle.dart
integration_test/test_bundle.dart

# Golden-test failure artifacts (isolatedDiff/maskedDiff/masterImage/testImage),
# rewritten on every failing golden run. The baselines under test/goldens/ are
# tracked; these per-run diffs must not be.
test/goldens/failures/
