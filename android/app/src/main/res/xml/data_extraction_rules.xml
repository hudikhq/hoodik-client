<?xml version="1.0" encoding="utf-8"?>
<!-- Android 12+ (API 31+). allowBackup="false" already blocks cloud backup, but
     device-to-device transfer is governed here independently, so exclude
     everything from both channels. -->
<data-extraction-rules>
    <cloud-backup>
        <exclude domain="file" path="." />
    </cloud-backup>
    <device-transfer>
        <exclude domain="file" path="." />
    </device-transfer>
</data-extraction-rules>
