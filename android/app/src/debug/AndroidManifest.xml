<manifest xmlns:android="http://schemas.android.com/apk/res/android">
    <!-- The INTERNET permission is required for development. Specifically,
         the Flutter tool needs it to communicate with the running application
         to allow setting breakpoints, to provide hot reload, etc.
    -->
    <uses-permission android:name="android.permission.INTERNET"/>

    <!-- Debug-only: allow cleartext HTTP so Patrol compat tests can reach
         the ephemeral `hudik/hoodik:<tag>` container via http://10.0.2.2:5443
         (the emulator's alias for the host's 127.0.0.1). The compat container
         runs SSL_DISABLED=true because per-version cert-trust dances add zero
         signal. This manifest is only merged into the debug variant, so
         release builds never ship cleartext. -->
    <application
        android:usesCleartextTraffic="true" />
</manifest>
